# FoodRush Docker Compose Environment Configuration
# Copy this file to .env before running `docker compose up`

NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://mongo:27017/foodrush

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_strong_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_strong_jwt_refresh_secret_min_32_chars

CLIENT_ORIGINS=http://localhost:80,http://localhost:5173
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=your_mock_payment_secret
