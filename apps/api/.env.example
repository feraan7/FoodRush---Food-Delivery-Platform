NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/foodrush
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_ORIGINS=http://localhost:5173
# Payments: "mock" works with no credentials. Use "razorpay" with your test keys.
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key
